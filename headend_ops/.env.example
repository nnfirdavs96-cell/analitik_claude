# ============================================================
# Application
# ============================================================
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-long-random-string
APP_LOG_LEVEL=INFO

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://headend:headend_pass@postgres:5432/headend_ops
DATABASE_URL_SYNC=postgresql+psycopg2://headend:headend_pass@postgres:5432/headend_ops
POSTGRES_USER=headend
POSTGRES_PASSWORD=headend_pass
POSTGRES_DB=headend_ops

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1
# Confidence threshold below which records go to review queue
AI_CONFIDENCE_THRESHOLD=0.65

# ============================================================
# Telegram Bot
# ============================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Set to "webhook" in production, "polling" in development
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-domain.com/bot/webhook
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here
# Comma-separated list of allowed group chat IDs (leave empty to allow all)
TELEGRAM_ALLOWED_CHAT_IDS=

# ============================================================
# API
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ============================================================
# Report Storage
# ============================================================
REPORTS_DIR=/app/reports_output

# ============================================================
# KPI Weights (must sum to 1.0)
# ============================================================
KPI_WEIGHT_INCIDENT=0.40
KPI_WEIGHT_RESOLUTION=0.20
KPI_WEIGHT_WORK=0.20
KPI_WEIGHT_REPEAT=0.10
KPI_WEIGHT_AI_QUALITY=0.10
